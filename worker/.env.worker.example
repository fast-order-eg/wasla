# Copy to worker/.env (keep it out of version control).
# The same WORKER_API_KEY must be configured on the cloud server.
CLOUD_BASE_URL=http://127.0.0.1:3080
ALLOW_LOCALHOST_HTTP=true
WORKER_API_KEY=
WORKER_ID=windows-worker-1
WORKER_NAME=Windows local worker
# Optional TCP health check only; this does NOT route Node.js through the proxy.
MOBILE_PROXY_URL=socks5://127.0.0.1:1080
WORKER_INTERVAL_MS=30000
WORKER_REQUEST_TIMEOUT_MS=10000
WORKER_PROBE_TIMEOUT_MS=3000
WORKER_MAX_FAILURES=5
WORKER_MAX_BACKOFF_MS=60000
