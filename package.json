{
  "name": "social-commerce-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Arabic social commerce operations desk with explicit human review",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test tests/*.test.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "worker": "node --env-file-if-exists=worker/.env worker/index.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "multer": "^2.5.0",
    "mysql2": "^3.14.0"
  }
}
